{
  "name": "elan-job-search",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "worker": "tsx workers/main.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "e2e": "node scripts/with-services.mjs npx playwright test",
    "test:integration": "vitest run tests/integration",
    "smoke:live": "node scripts/with-services.mjs node scripts/smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cheerio": "1.1.2",
    "docx": "9.5.1",
    "imapflow": "2.2.5",
    "ipaddr.js": "2.2.0",
    "lucide-react": "0.468.0",
    "mailparser": "3.9.36",
    "mammoth": "1.12.2",
    "next": "15.5.28",
    "nodemailer": "10.1.2",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "0.15.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "robots-parser": "3.0.1",
    "zod": "4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.28",
    "prisma": "6.12.0",
    "tailwindcss": "4.1.17",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
}
