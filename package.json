{
  "name": "elan-job-search",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "worker": "tsx workers/main.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cheerio": "1.1.2",
    "ipaddr.js": "2.2.0",
    "lucide-react": "0.468.0",
    "mammoth": "1.12.2",
    "next": "15.5.25",
    "nodemailer": "10.0.1",
    "pdf-parse": "1.1.1",
    "pdfkit": "0.15.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "robots-parser": "3.0.1",
    "zod": "4.1.12"
  },
  "overrides": {
    "next": { "postcss": "8.5.23", "sharp": "0.35.4" }
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/pdf-parse": "1.1.4",
    "@types/pdfkit": "0.13.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.25",
    "prisma": "6.12.0",
    "tailwindcss": "4.1.17",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
}
