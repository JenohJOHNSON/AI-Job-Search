# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elan
# Optional: direct (non-pooled) connection used only for migrations by the web image. Needed only when
# DATABASE_URL goes through a transaction-mode pooler other than Neon's (a Neon "-pooler" host is
# turned into its direct host automatically), e.g. PgBouncer.
# DIRECT_URL=
# Public origin of the web app (no trailing slash). Used for same-origin checks and links.
APP_URL=http://localhost:3000
# One-time secret asked for when creating the owner account (16+ characters).
SETUP_SECRET=replace-with-a-one-time-setup-secret
# Bearer secret for POST /api/internal/jobs/run (GitHub Actions backup trigger), 24+ characters, different from SETUP_SECRET.
JOB_RUNNER_SECRET=replace-with-a-different-long-random-secret
# Deprecated, no longer needed (sessions are random hashed tokens). Accepted if already set.
# NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# Job sources
# ---------------------------------------------------------------------------
# France Travail official API (optional): create an application at https://francetravail.io and subscribe it to "Offres d'emploi v2".
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Greenhouse / Lever / Ashby / company pages need no credentials: add employer boards under "Job sources" in the app.
# Job-alert emails (optional): read-only IMAP access to the mailbox that receives LinkedIn / Indeed / HelloWork /
# Welcome to the Jungle job alerts. For Gmail, create an app password (2-step verification required) and URL-encode the "@".
# IMAP_URL=imaps://you%40gmail.com:app-password@imap.gmail.com:993/INBOX
IMAP_URL=
# Paid portal scraping (optional, opt-in per source): Apify API token; runs are billed to this Apify account.
# LinkedIn, Indeed, HelloWork and Welcome to the Jungle forbid automated collection in their terms; enabling these is your decision.
APIFY_API_TOKEN=

# ---------------------------------------------------------------------------
# AI (optional). Matching, notifications and tracking work without it using the rule-based engine.
# AI refines scores for the best candidates and writes CV suggestions / cover letters within the limits below.
# ---------------------------------------------------------------------------
# One of: openai, anthropic, gemini, openrouter
AI_PROVIDER=openai
AI_MODEL=
AI_FALLBACK_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Multi-model job scoring (docs/AI_SCORING.md). With OPENROUTER_API_KEY set, each job above AI_MATCH_THRESHOLD is scored by
# every slot on one rubric and its final score is the average. A slot is "primary,fallback,fallback" in OpenRouter model IDs
# (https://openrouter.ai/models); an empty slot is disabled. Prices come from OpenRouter, so no price variables are needed.
# For the cheaper GPT-6 variant put openai/gpt-6-luna first in slot 3.
AI_SCORING_SLOT_1=anthropic/claude-sonnet-5.5,anthropic/claude-sonnet-5,openai/gpt-6.1-sol
AI_SCORING_SLOT_2=anthropic/claude-fable-5.1,anthropic/claude-fable-5,anthropic/claude-opus-5.5
AI_SCORING_SLOT_3=openai/gpt-6-astra,openai/gpt-6-luna,openai/gpt-6-sol
# default, minimal, low, medium or high; reasoning tokens are billed as output.
AI_SCORING_REASONING_EFFORT=low
# USD per million tokens for the exact configured model. Paid calls stay disabled without both prices.
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=

# ---------------------------------------------------------------------------
# Notifications (optional). Enable and tune them in Settings; these provide the transport credentials.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=
DIGEST_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Hard ceilings and defaults. The owner can lower the AI and volume limits in Settings, never raise them above these.
# ---------------------------------------------------------------------------
MAX_AI_ANALYSES_PER_DAY=30
MAX_LLM_COST_PER_DAY=2
MAX_JOBS_PER_PROVIDER=50
MAX_TOTAL_JOBS_PER_RUN=200
AI_MATCH_THRESHOLD=40
NOTIFICATION_SCORE_THRESHOLD=80
SESSION_TTL_DAYS=14
TASK_LEASE_SECONDS=300

# Reserved: no code path uses these, nothing is ever sent to them.
FIRECRAWL_API_KEY=
SCRAPERAPI_KEY=
