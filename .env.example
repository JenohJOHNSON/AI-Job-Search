# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elan
APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
SETUP_SECRET=replace-with-a-one-time-setup-secret
JOB_RUNNER_SECRET=replace-with-a-different-long-random-secret

# AI (optional; matching remains deterministic until configured)
AI_PROVIDER=openai
AI_MODEL=
AI_FALLBACK_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# USD per million tokens for the exact configured model. Paid calls are disabled without these.
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=

# Official France Travail API (optional)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Reserved for future adapters; the current release has no code path using these keys
FIRECRAWL_API_KEY=
SCRAPERAPI_KEY=
APIFY_API_TOKEN=

# Optional notifications
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=
DIGEST_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Limits
MAX_AI_ANALYSES_PER_DAY=30
MAX_LLM_COST_PER_DAY=2
MAX_JOBS_PER_PROVIDER=50
MAX_TOTAL_JOBS_PER_RUN=200
AI_MATCH_THRESHOLD=40
NOTIFICATION_SCORE_THRESHOLD=80
SESSION_TTL_DAYS=14
TASK_LEASE_SECONDS=300
